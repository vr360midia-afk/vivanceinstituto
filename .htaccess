# ======================================================================
# .HTACCESS - OTIMIZAÇÃO DE SEO, PERFORMANCE E URLS LIMPAS
# Instituto Vivance - Dr. Danilo Marques
# ======================================================================

RewriteEngine On
RewriteBase /

# 1. REDIRECIONAMENTO CANÔNICO DE /paginas/*.html PARA URL LIMPA NA RAIZ (301)
RewriteCond %{THE_REQUEST} \s/+paginas/([^.\s?]+)(?:\.html)?[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. REDIRECIONA URLS LIMPAS PARA ARQUIVOS NA RAIZ (Ex: /blog -> blog.html, /tratamento-obesidade-maceio -> tratamento-obesidade-maceio.html)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# 3. FALLBACK: REDIRECIONA URLS LIMPAS PARA A PASTA /paginas/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/paginas/$1.html -f
RewriteRule ^([^/]+)/?$ paginas/$1.html [L]

# 4. REDIRECIONA IMAGENS DAS SUBPÁGINAS (Se chamadas da raiz)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/paginas/$1 -f
RewriteRule ^([^/]+\.(jpg|webp|png))$ paginas/$1 [L]

# 5. CACHE DE NAVEGADOR PARA ALTA VELOCIDADE (Core Web Vitals)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# 6. COMPRESSÃO GZIP / BROTLI
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
